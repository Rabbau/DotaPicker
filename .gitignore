# Сохранённые лобби (содержат секретные ключи капитанов и админа).
# Кеш данных модели пик-трейнинга (data/model-cache) храним в репозитории — секретов в нём нет.
data/*
!data/model-cache/

# Зависимости и логи (на случай, если появятся)
node_modules/
npm-debug.log*
*.log

# Локальные настройки редакторов и инструментов
.claude/
.vscode/
.idea/

# Системный мусор
.DS_Store
Thumbs.db
desktop.ini

# Токен STRATZ API (не публиковать)
.stratz-token
.env
